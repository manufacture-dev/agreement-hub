# Frontend environment variables
# Copy this file to .env.local and adjust as needed.

# Optional for hosting without the Vite proxy or using a remote backend.
# Set before `npm run build`; the backend must allow the frontend's CORS origin.
# Leave unset for local dev and preview: both proxy /api to port 3001.
#
# VITE_API_BASE_URL=http://localhost:3001
